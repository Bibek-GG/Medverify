# MedVerify India — Environment Configuration

# Database Configuration
# Default: Zero-configuration SQLite for immediate local execution
DATABASE_URL=sqlite:///./backend/medverify.db

# To use PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medverify

# Application Mode
DEMO_MODE=true

# Backend Server
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend API URL
VITE_API_URL=http://localhost:8000/api
